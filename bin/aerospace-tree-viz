#!/bin/bash
# Visualize the Aerospace window tree, by polling it repeatedly.
# Will probably eat your battery, so use it for learning, and close it
# when you're done.

set -ueo pipefail

require() {
  local cmd="$1"
  command -v "$cmd" || {
    echo "Requires $1 (from $2)" >&2
    exit 1
  }
}

DOT=$(require dot "graphviz")
AEROSPACE=$(require aerospace "AeroSpace window manager")
AEROSPACE_TREE_DOT=$(require aerospace-tree-dot "this repo, try 'cargo install --path .'")

# Create temp file - macOS mktemp works differently than Linux
tmpbase=$(mktemp -t aerospace-tree)
img="$tmpbase.svg"

# On macOS, open SVG with Safari; on Linux use eog
if [[ "$(uname)" == "Darwin" ]]; then
  viewer() { open -a Safari "$1"; }
else
  VIEWER=$(require eog "Gnome")
  viewer() { "$VIEWER" "$1"; }
fi
trap "if [[ -r \"$img\".pid ]]; then xargs kill <\"$img\".pid 2>/dev/null || true; fi; rm -f \"$tmpbase\" \"$img\"{,.{new,sha256,pid}}" EXIT

while true; do
  "$AEROSPACE" list-windows --all --json --format '%{window-id} %{app-name} %{workspace} %{window-title}' \
    | "$AEROSPACE_TREE_DOT" \
    | "$DOT" -Tsvg >"$img".new

  # Use sha256 instead of sha1 for better compatibility
  if ! (echo "$(cat "$img".new | shasum -a 256 | cut -d' ' -f1) $img.new" | shasum -a 256 -c - 2>/dev/null && \
        cat "$img".sha256 2>/dev/null | shasum -a 256 -c - 2>/dev/null); then
    mv "$img"{.new,} && shasum -a 256 "$img" > "$img".sha256
  fi

  if [[ ! -f "$img".pid ]]; then
    viewer "$img" &
    echo $! >"$img".pid
  fi

  # Check if viewer is still running (different approach for macOS vs Linux)
  if [[ -r "$img".pid ]]; then
    if ! ps -p $(cat "$img".pid) >/dev/null 2>&1; then
      break
    fi
  fi

  sleep 1
done
